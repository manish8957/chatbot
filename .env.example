# NVIDIA NIM API Configuration
# Get your free API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# Tavily Web Search API Configuration
# Get your API key from: https://app.tavily.com/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Application Settings (Optional)
MAX_PDF_SIZE_MB=20
SQLITE_DB_PATH=database/chatbot.db
UPLOAD_DIR=uploaded_files
